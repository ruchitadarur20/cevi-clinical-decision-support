# Portfolio demo build (npm run build:demo). Contains no secrets: every VITE_* value is public in the bundle.
VITE_DEMO_MODE=true

# Owner-supplied links for the two call-to-action buttons. While empty, the buttons render disabled.
# Prefer setting these as Cloudflare Pages environment variables (they override this file), or in
# .env.demo.local (git-ignored). Examples:
#   VITE_DEMO_CONTACT_URL=mailto:you@example.com   or   https://www.linkedin.com/in/your-profile
#   VITE_DEMO_REPO_URL=https://github.com/<owner>/<repo>
VITE_DEMO_CONTACT_URL=
VITE_DEMO_REPO_URL=
