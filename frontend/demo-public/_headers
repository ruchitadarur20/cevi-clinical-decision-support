# Cloudflare Pages response headers for the static portfolio demo.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-LJSihK7eAHiuAPsXCXjUorag0iuxl77HfsCKabRsgyY='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/demo/images/*
  Cache-Control: public, max-age=86400

/index.html
  Cache-Control: no-cache
